{
  "name": "tune",
  "version": "1.2.2",
  "description": "Tune - driver updater and PC optimizer",
  "author": "Or meir Tzarfati",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5175 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build:service && electron .",
    "dist": "npm run build:service && vite build && electron-builder --win nsis --x64",
    "release": "npm run build:service && vite build && electron-builder --win nsis --x64 --publish always",
    "build:service": "node scripts/build-service.cjs"
  },
  "repository": "github:OrMeirDev/Tune",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.tune.optimizer",
    "productName": "Tune",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "service/bin",
        "to": "service"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "OrMeirDev",
        "repo": "Tune",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tune",
      "installerLanguages": [
        "en_US",
        "he_IL"
      ],
      "language": "1033",
      "artifactName": "Tune-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": false
    }
  }
}
